# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/

# Env & secrets
.env
.env.*
!.env.example
credentials.txt

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*

# Vercel / Render
.vercel
.render

# Raw brand-identity source (large binaries). Processed web assets in
# apps/*/public/brand ARE committed; regenerate via tools/process-brand-assets.mjs
*.zip
.brand-extract/

# Local docx originals are tracked; extracted media is not regenerated in CI
tools/.mongo-uri

# Raven agent scratch (session cache + local audit trail). Any versioned Raven
# config (manifest.json, architecture.md) is deliberately NOT ignored here.
# Anchored patterns only match at the repo root, so the copies under apps/*
# were being committed. The ** prefix catches them wherever they appear.
**/.raven/.cache/
**/.raven/.model-session.json
**/.raven/audit/
**/.raven/state/

# Temporary live-proxy dev configs (point a local app at the production API)
apps/*/vite.live.config.ts

# Raw portrait drops (originals live in Drive; processed copies go to Cloudinary)
/*.JPG
/*.jpg
/*.jpeg
/*.JPEG
/*.png
/*.PNG
/*.webp
/portraits/
