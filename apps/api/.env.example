# Environment template for the IAA API.
# Variable names only — never commit real values. User and account OAuth tokens
# are held encrypted in the database, not here.

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
PUBLIC_SITE_URL=
ADMIN_URL=
CORS_ORIGINS=

# ── Database & JWT ──────────────────────────────────────────────────────
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Email ───────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_NOTIFY_TO=

# ── Cloudinary ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=

# ── Social publishing ───────────────────────────────────────────────────
# Encrypts stored account tokens at rest. 32-byte base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Public base URL of this API. Each provider's redirect URI is derived from it
# and must be registered in that provider's developer console exactly.
SOCIAL_OAUTH_REDIRECT_BASE=

# Meta — Facebook Pages and Instagram professional accounts.
# Redirect URI: <SOCIAL_OAUTH_REDIRECT_BASE>/api/social/meta/callback
META_APP_ID=
META_APP_SECRET=

# LinkedIn — member and organisation posting.
# Redirect URI: <SOCIAL_OAUTH_REDIRECT_BASE>/api/social/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X — user-context posting.
# Redirect URI: <SOCIAL_OAUTH_REDIRECT_BASE>/api/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# "true" makes an editor's social posts wait for an administrator. Off by
# default; administrators publish directly either way.
SOCIAL_REQUIRE_APPROVAL=

# ── Payments ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── MFA ─────────────────────────────────────────────────────────────────
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_FOR_ROLES=

# ── Data retention (days) ───────────────────────────────────────────────
SUBMISSION_RETENTION_DAYS=
UNSUBSCRIBED_RETENTION_DAYS=
FAILED_DONATION_RETENTION_DAYS=
