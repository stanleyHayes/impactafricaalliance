{
  "name": "impact-africa-alliance",
  "version": "1.0.0",
  "private": true,
  "description": "Impact Africa Alliance — marketing website, admin console, and API (monorepo)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {},
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @iaa/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @iaa/api",
    "dev:marketing": "npm run dev -w @iaa/marketing",
    "dev:admin": "npm run dev -w @iaa/admin",
    "seed": "npm run seed -w @iaa/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
