# ──────────────────────────────────────────────────────────────────────────
# Impact Africa Alliance — environment contract
# Copy the relevant block into each workspace's own .env file. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────

# == apps/api ==============================================================
NODE_ENV=development
PORT=4000

# MongoDB Atlas (free M0). e.g. mongodb+srv://user:pass@cluster/iaa
MONGODB_URI=mongodb://127.0.0.1:27017/iaa

# Comma-separated allow-list of front-end origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth — production requires distinct access and refresh secrets.
JWT_ACCESS_SECRET=change-me-in-prod-min-32-chars-long-secret-access
JWT_REFRESH_SECRET=change-me-in-prod-min-32-chars-long-secret-refresh
# Deprecated fallback used only in local/test when the secrets above are absent:
# JWT_SECRET=change-me-in-prod-min-32-chars-long-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Express trust-proxy setting. In production use the trusted reverse-proxy count
# or comma-separated IP list (e.g. '1' behind one load balancer, 'loopback,10.0.0.1').
TRUST_PROXY=1

# First admin (used by `npm run seed`). SEED_ADMIN_PASSWORD must be >= 10 chars.
SEED_ADMIN_EMAIL=admin@impactafricaalliance.org
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=IAA Administrator

# Optional: shared password for seeded editor accounts. If omitted, a random
# password is generated and logged during seed.
SEED_EDITOR_PASSWORD=

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Impact Africa Alliance <no-reply@impactafricaalliance.org>"
EMAIL_NOTIFY_TO=info@impactafricaalliance.org

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-secret
CLOUDINARY_UPLOAD_FOLDER=iaa

# Payments — Stripe (international)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Payments — Paystack (African)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=

# MFA (optional in dev/test, required in production)
# Generate a 32-byte base64 key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# Comma-separated roles that must enable MFA (e.g. admin,superadmin). Leave empty for optional.
MFA_REQUIRED_FOR_ROLES=

# Data protection / retention (optional)
DPO_EMAIL=info@impactafricaalliance.org
SUBMISSION_RETENTION_DAYS=1095
UNSUBSCRIBED_RETENTION_DAYS=90
FAILED_DONATION_RETENTION_DAYS=30

# Social publishing (all optional — leave empty to disable)
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Social OAuth (required for the admin "Connect" buttons to work)
# Generate a 32-byte base64 key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Falls back to MFA_ENCRYPTION_KEY in development when empty.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Public API base URL used to build OAuth redirect URIs.
SOCIAL_OAUTH_REDIRECT_BASE=http://localhost:4000
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# == apps/marketing (Vite — must be prefixed VITE_) =========================
VITE_API_URL=http://localhost:4000/api
VITE_GA4_MEASUREMENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# == apps/admin (Vite) =====================================================
# VITE_API_URL shared contract (set in the admin project)
# VITE_API_URL=http://localhost:4000/api
