# ──────────────────────────────────────────────────────────────────────────
# Impact Africa Alliance — environment contract
# Copy the relevant block into each workspace's own .env file. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────

# == apps/api ==============================================================
NODE_ENV=development
PORT=4000

# MongoDB Atlas (free M0). e.g. mongodb+srv://user:pass@cluster/iaa
MONGODB_URI=mongodb://127.0.0.1:27017/iaa

# Comma-separated allow-list of front-end origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth
JWT_SECRET=change-me-in-prod-min-32-chars-long-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# First admin (used by `npm run seed`). SEED_ADMIN_PASSWORD must be >= 10 chars.
SEED_ADMIN_EMAIL=admin@impactafricaalliance.org
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=IAA Administrator

# Optional: shared password for seeded editor accounts. If omitted, a random
# password is generated and logged during seed.
SEED_EDITOR_PASSWORD=

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Impact Africa Alliance <no-reply@impactafricaalliance.org>"
EMAIL_NOTIFY_TO=info@impactafricaalliance.org

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-secret
CLOUDINARY_UPLOAD_FOLDER=iaa

# Payments — Stripe (international)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Payments — Paystack (African)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=

# == apps/marketing (Vite — must be prefixed VITE_) =========================
VITE_API_URL=http://localhost:4000/api
VITE_GA4_MEASUREMENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# == apps/admin (Vite) =====================================================
# VITE_API_URL shared contract (set in the admin project)
# VITE_API_URL=http://localhost:4000/api
